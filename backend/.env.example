# ---------- Core ----------
ENVIRONMENT=development          # development | staging | production | test
DEBUG=true

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://educonnect:educonnect@localhost:5432/educonnect

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Storage ----------
STORAGE_DIR=./storage

# ---------- CORS ----------
# Comma-separated list or JSON array. Wildcard "*" is rejected (credentials are enabled).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Optional (used in later steps) ----------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_STORAGE_URI=memory://

# ---------- Logging ----------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=auto                  # auto = JSON in production/staging, text elsewhere

# ---------- TTS (Text-to-Speech) ----------
TTS_PROVIDER=auto                # auto | piper | local (espeak)
PIPER_VOICES_DIR=./voices        # path to *.onnx + *.onnx.json voice models
PIPER_DEFAULT_VOICE=en_US-lessac-medium
TTS_CACHE_DIR=./tts_cache
TTS_RATE_LIMIT=20/minute         # per-IP rate limit for POST /accessibility/tts

# ---------- Celery (background worker) ----------
# DB index 2 keeps Celery tasks separate from app data (DB 0) and rate limits (DB 1).
CELERY_BROKER_URL=redis://localhost:6379/2

# ---------- Per-IP limits for /auth/* ----------
AUTH_RATE_LIMIT_REGISTER=5/minute
AUTH_RATE_LIMIT_LOGIN=10/minute
AUTH_RATE_LIMIT_REFRESH=30/minute
AUTH_RATE_LIMIT_LOGOUT=30/minute
AUTH_RATE_LIMIT_ME=60/minute